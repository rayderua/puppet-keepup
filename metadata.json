{
  "name": "code_tool-keepup",
  "version": "1.4.4",
  "author": "code_tool",
  "license": "MIT",
  "summary": "Installs and configures keepup - a package version monitoring agent",
  "source": "https://github.com/code-tool/puppet-keepup",
  "issues_url": "https://github.com/code-tool/puppet-keepup/issues",
  "project_page": "https://github.com/code-tool/puppet-keepup",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 4.25.0 < 10.0.0"
    },
    {
      "name": "puppetlabs/apt",
      "version_requirement": ">= 6.0.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": ["10", "11", "12", "13"]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": ["20.04", "22.04", "24.04"]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 6.0.0 < 9.0.0"
    }
  ]
}
